# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com segredos reais (já está no .gitignore).

# --- Banco de dados ---
DB_NAME=neurogen
DB_USERNAME=neurogen
# Gere com: openssl rand -base64 32
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE

# --- Chave de dados sensíveis (LGPD / AES-256) ---
# Gere com: openssl rand -hex 32  (resultado: 64 chars hex)
SENSITIVE_DATA_KEY=SUBSTITUA_POR_64_CHARS_HEX_AQUI

# --- pgAdmin ---
# Gere com: openssl rand -base64 16
PGADMIN_PASSWORD=SUBSTITUA_POR_SENHA_PGADMIN

# --- Vault (opcional: isolamento físico em prod) ---
# VAULT_DB_URL=jdbc:postgresql://vault-db-host:5432/vault
# VAULT_DB_USERNAME=vault_user
# VAULT_DB_PASSWORD=SENHA_VAULT
